    "    \"goals_scored\", \"assists\", \"attacking_contribution\",\n",
    "    \"points_per_90\", \"ownership_pct\",\n",
    "]].head(15))\n",
    "\n",
    "print(\"\\nGoalkeeper attacking contributions:\")\n",
    "attacking_keepers = keepers[keepers[\"attacking_contribution\"] > 0]\n",
    "if attacking_keepers.empty:\n",
