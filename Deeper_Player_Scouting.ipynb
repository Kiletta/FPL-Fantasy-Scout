    "keepers[\"attacking_contribution\"] = keepers[\"goals_scored\"] + keepers[\"assists\"]\n",
    "\n",
    "keepers = keepers.sort_values(\n",
    "    [\"attacking_contribution\", \"clean_sheets\", \"saves_per_90\", \"points_per_90\"],\n",
    "    ascending=False,\n",
    ")\n",
